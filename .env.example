# Frontend (Vite) — em produção use /api (mesma origem)
VITE_API_URL=/api

# Backend
PORT=3001
DATABASE_URL=postgresql://gabriela:gabriela_dev@localhost:5433/gabriela_dental
JWT_SECRET=change-me-in-production-use-long-random-string
ADMIN_EMAIL=admin@gabrielabarreto.com
ADMIN_PASSWORD=admin123
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Consulta CPF (opcional — não existe API pública gratuita por LGPD)
# Use Serpro Consulta CPF ou outro provedor autorizado.
# CPF_LOOKUP_URL=https://seu-provedor/cpf/{cpf}
# CPF_LOOKUP_TOKEN=

# IA do chat — recomendado para público de odontologia
# Com OPENAI_API_KEY: respostas técnicas + geração de imagens educacionais.
# Sem chave: fallback local (texto); imagens exigem a chave.
# Coloque a chave no .env da raiz do projeto e reinicie o server.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=dall-e-3

# Opcional — download automático GLB Dundee (Sketchfab)
# SKETCHFAB_API_TOKEN=

# Pagamentos (Mercado Pago) — sem estas chaves o checkout fica em modo demo
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=
# PAYMENT_WEBHOOK_SECRET=
# PUBLIC_APP_URL=https://gbdental.com.br

# Contatos públicos (frontend)
# Use DDI+DDD+número, só dígitos. Ex.: 55859XXXXXXXX
# VITE_WHATSAPP_PHONE=5585XXXXXXXXX
# VITE_WHATSAPP_DISPLAY=(85) XXXXX-XXXX
# VITE_WHATSAPP_PREFILL=Olá! Estou acessando a plataforma GB Dental e gostaria de tirar uma dúvida.
# VITE_INSTAGRAM_URL=https://instagram.com/...
