# Produção — GB Dental (servidor / Nginx)
# Copie para /var/www/gbdental/.env e ajuste.

VITE_API_URL=/api
PORT=3001
NODE_ENV=production

# Postgres acessível a partir do 10.100.15.2
DATABASE_URL=postgresql://gabriela:SENHA@HOST:5432/gabriela_dental

JWT_SECRET=troque-por-string-longa-e-aleatoria
ADMIN_EMAIL=admin@gabrielabarreto.com
ADMIN_PASSWORD=troque-esta-senha

CORS_ORIGIN=https://gbdental.com.br,http://gbdental.com.br,https://www.gbdental.com.br,http://www.gbdental.com.br

# Opcional
# CPF_LOOKUP_URL=
# CPF_LOOKUP_TOKEN=

# Pagamentos (sem isto o checkout fica em modo demo)
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=
# PAYMENT_WEBHOOK_SECRET=
# PUBLIC_APP_URL=https://gbdental.com.br
